generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  userId        String   @unique
  balance       Float    @default(0)
  bank          Float    @default(0)
  kiboCash      Float    @default(0)
  dirtyMoney    Float    @default(0) // Grana suja que precisa ser lavada
  isPremium     Boolean  @default(false)
  vipExpiresAt  DateTime?
  skills        Json     @default("{\"sorte\": 1, \"labia\": 1, \"agilidade\": 1, \"inteligencia\": 1, \"forca\": 1, \"intimidacao\": 1}")
  badges        String[]
  isBanned      Boolean  @default(false)
  currentJob    String    @default("desempregado") // "onesto", "crime", "hacker"
  jobStartedAt  DateTime? // Data que iniciou o trabalho atual
  inventory     Inventory[]
  businesses    UserBusiness[]
  bio           String    @default("Usa 'k bio' para alterares a tua biografia!")
}

model Transaction {
  id          String   @id @default(uuid())
  fromUserId  String   
  toUserId    String   
  amount      Float
  timestamp   DateTime @default(now())
}


model Cooldown {
  id        String   @id @default(uuid())
  userId    String
  command   String   // 'executar', 'daily', 'mensal', etc
  expiresAt DateTime
  @@unique([userId, command])
}

model ShopItem {
  id          String @id @default(uuid())
  name        String @unique
  price       Int
  description String
  type        String // Ex: 'COSMETIC', 'BOOSTER', 'UTILITY'
}

model Inventory {
  id     String @id @default(uuid())
  userId String
  itemId String
  amount Int    @default(1) // <-- ADICIONE ESTA LINHA
  user   User   @relation(fields: [userId], references: [userId])
}

model UserBusiness {
  id            String   @id @default(uuid())
  userId        String
  businessId    String   
  lastCollected DateTime @default(now())
  forSalePrice  Float?   // NOVO: Preço de venda definido pelo jogador (nulo se não estiver à venda)
  user          User     @relation(fields: [userId], references: [userId])
}

// Tabela para guardar quem tem distintivo em qual servidor
model PoliceBadge {
  id        String   @id @default(uuid())
  userId    String
  guildId   String
  createdAt DateTime @default(now())

  @@unique([userId, guildId]) // Garante que o cara não é contratado duas vezes no mesmo server
}

model GuildConfig {
  id            String   @id @default(uuid())
  guildId       String   @unique
  wlActive      Boolean  @default(false)
  wlName        String?
  wlAvatar      String?
  wlWebhookUrl  String?
  casinoEnabled Boolean  @default(true)
  delegadoId    String?  // NOVO: A coluna do delegado fundida aqui!
}

// ==========================================
// 📈 SISTEMA DE CRIPTOMOEDAS (KIBO EXCHANGE)
// ==========================================

model CryptoMarket {
  coin      String   @id // Ex: 'BTK', 'KBC'
  name      String
  price     Float
  lastPrice Float
  updatedAt DateTime @default(now())
}

model CryptoWallet {
  userId        String   @id
  KBD           Float    @default(0)
  KBD_inv       Float    @default(0)
  QTK           Float    @default(0)
  QTK_inv       Float    @default(0)
  KBG           Float    @default(0)
  KBG_inv       Float    @default(0)
  BTK           Float    @default(0)
  BTK_inv       Float    @default(0)
  ETHK          Float    @default(0)
  ETHK_inv      Float    @default(0)
  KBC           Float    @default(0)
  KBC_inv       Float    @default(0)
  SOLK          Float    @default(0)
  SOLK_inv      Float    @default(0)
  DGK           Float    @default(0)
  DGK_inv       Float    @default(0)
  SHBK          Float    @default(0)
  SHBK_inv      Float    @default(0)
}

// ==========================================
// 🏴 SISTEMA DE FACÇÕES
// ==========================================

model Faction {
  id         String          @id @default(uuid())
  name       String
  tag        String
  ramo       String          // 'trafico' | 'armas' | 'lavagem' | 'hack' | 'transporte'
  guildId    String
  leaderId   String
  bank       Float           @default(0)
  influencia Int             @default(0)
  nivel      Int             @default(1)
  xp         Int             @default(0)
  estoque    Json            @default("{}") // Itens produzidos: {"droga_leve": 3, "arma_fuzil": 1}
  createdAt  DateTime        @default(now())
  members    FactionMember[]
  listings   FactionListing[]
  warsAsA    FactionWar[]    @relation("warA")
  warsAsB    FactionWar[]    @relation("warB")

  @@unique([guildId, name])
  @@unique([guildId, tag])
}

model FactionMember {
  id        String   @id @default(uuid())
  factionId String
  guildId   String
  userId    String
  rank      String   @default("membro") // 'lider' | 'capo' | 'membro'
  joinedAt  DateTime @default(now())
  faction   Faction  @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
}

// Anúncio de venda de item produzido pela facção
model FactionListing {
  id        String   @id @default(uuid())
  factionId String
  guildId   String
  itemId    String
  qty       Int
  price     Float
  createdAt DateTime @default(now())
  faction   Faction  @relation(fields: [factionId], references: [id], onDelete: Cascade)
}

// ⚔️ Guerra entre duas facções (disputa de roubos na duração, pote pro vencedor)
model FactionWar {
  id         String   @id @default(uuid())
  guildId    String
  channelId  String?
  factionAId String
  factionBId String
  bet        Float    // Valor apostado POR facção (sai do caixa)
  pointsA    Int      @default(0)
  pointsB    Int      @default(0)
  status     String   @default("proposta") // 'proposta' | 'ativo' | 'encerrada'
  winnerId   String?
  startedAt  DateTime @default(now())
  endsAt     DateTime?
  endedAt    DateTime?
  createdAt  DateTime @default(now())

  factionA Faction @relation("warA", fields: [factionAId], references: [id], onDelete: Cascade)
  factionB Faction @relation("warB", fields: [factionBId], references: [id], onDelete: Cascade)
}